{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artigo da Revista Turkista",
  "type": "object",
  "required": ["id", "slug", "titulo", "categoria", "resumo", "corpo", "capa", "status", "dataCriacao"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "titulo": { "type": "string", "minLength": 1, "maxLength": 120 },
    "categoria": {
      "type": "string",
      "enum": ["guia-de-cuidados", "tecido-tecnologia", "estilo", "treino-performance", "bastidores"]
    },
    "resumo": { "type": "string", "minLength": 1, "maxLength": 200 },
    "corpo": { "type": "string", "minLength": 1 },
    "capa": {
      "type": "object",
      "required": ["arquivo"],
      "properties": {
        "arquivo": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "tempoLeitura": { "type": "string" },
    "status": { "type": "string", "enum": ["rascunho", "publicado"] },
    "dataCriacao": { "type": "string" }
  }
}
